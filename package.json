{
  "name": "evo-polaris",
  "version": "0.0.0.1.0",
  "description": "Free, open-source, accessible polar-alignment assistant for star trackers and equatorial mounts.",
  "type": "module",
  "license": "MIT",
  "author": "Kelly Michels <dev@evomedia.net> (https://evomedia.net)",
  "homepage": "https://polaris.evomedia.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/evomedia-net/evo.polaris.git"
  },
  "bugs": {
    "url": "https://github.com/evomedia-net/evo.polaris/issues"
  },
  "private": false,
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "version:print": "node scripts/bump-version.mjs get",
    "bump-version": "node scripts/bump-version.mjs bump",
    "version:stage": "node scripts/bump-version.mjs bump-stage",
    "version:tag": "node scripts/bump-version.mjs tag-command",
    "build-data": "python scripts/build-data.py",
    "build-milkyway": "python scripts/build-milkyway.py",
    "serve": "node scripts/serve.mjs",
    "docs:twins": "node scripts/md-txt.mjs",
    "docs:check": "node scripts/md-txt.mjs --check",
    "precache-stamp": "node scripts/precache-stamp.mjs",
    "pwa-images": "node scripts/capture-pwa-images.mjs",
    "build-constellations": "python scripts/build-constellations.py"
  },
  "keywords": [
    "astronomy",
    "astrophotography",
    "polar-alignment",
    "polaris",
    "accessibility",
    "a11y",
    "pwa",
    "ioptron",
    "star-tracker"
  ]
}
